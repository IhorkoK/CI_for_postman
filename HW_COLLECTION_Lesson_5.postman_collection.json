		{
			"name": "get_list_test + schema",
			"item": [
				{
					"name": "Create_list + schema",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();\r",
									"\r",
									"var id = jsonData.id;\r",
									"\r",
									"console.log(\"list id for get metod\", id);\r",
									"\r",
									"pm.collectionVariables.set (\"list_id_for_get_test\", id)\r",
									"\r",
									"const Ajv = require('ajv');\r",
									"const ajv = new Ajv();\r",
									"\r",
									"var schema = {\r",
									"    \"type\": \"object\",\r",
									"    \"properties\": {\r",
									"    id: { type: \"string\" },\r",
									"    name: { type: \"string\" },\r",
									"    deleted: { type: \"boolean\" },\r",
									"    orderindex: { type: \"integer\" },\r",
									"    content: { type: \"string\" },\r",
									"    priority: { type: [\"null\", \"string\"] },\r",
									"    assignee: { type: [\"null\", \"string\", \"object\"] },\r",
									"    due_date: { type: [\"null\", \"string\"] },\r",
									"    start_date: { type: [\"null\", \"string\"] },\r",
									"    folder: {\r",
									"      type: \"object\",\r",
									"      required: [\"id\", \"name\", \"hidden\", \"access\"],\r",
									"      properties: {\r",
									"        id: { type: \"string\" },\r",
									"        name: { type: \"string\" },\r",
									"        hidden: { type: \"boolean\" },\r",
									"        access: { type: \"boolean\" }\r",
									"      }\r",
									"    },\r",
									"    space: {\r",
									"      type: \"object\",\r",
									"      required: [\"id\", \"name\", \"access\"],\r",
									"      properties: {\r",
									"        id: { type: \"string\" },\r",
									"        name: { type: \"string\" },\r",
									"        access: { type: \"boolean\" }\r",
									"      }\r",
									"    },\r",
									"    inbound_address: { type: \"string\", format: \"email\" },\r",
									"    archived: { type: \"boolean\" },\r",
									"    override_statuses: { type: \"boolean\" },\r",
									"    statuses: {\r",
									"      type: \"array\",\r",
									"      items: {\r",
									"        type: \"object\",\r",
									"        required: [\"id\", \"status\", \"orderindex\", \"color\", \"type\", \"status_group\"],\r",
									"        properties: {\r",
									"          id: { type: \"string\" },\r",
									"          status: { type: \"string\" },\r",
									"          orderindex: { type: \"integer\" },\r",
									"          color: { type: \"string\", pattern: \"^#[0-9a-fA-F]{6}$\" },\r",
									"          type: { type: \"string\" },\r",
									"          status_group: { type: \"string\" }\r",
									"        }\r",
									"      }\r",
									"    },\r",
									"    permission_level: { type: \"string\" }\r",
									"  },\r",
									"    \"required\": [\"id\", \"name\", \"deleted\", \"orderindex\", \"content\"]\r",
									"};\r",
									"\r",
									"const validate = ajv.compile(schema);\r",
									"const response = pm.response.json();\r",
									"\r",
									"pm.test(\"Schema is valid\", function () {\r",
									"   const valid = validate(response);\r",
									"   pm.expect(valid, JSON.stringify(validate.errors)).to.be.true;\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"auth": {
							"type": "apikey",
							"apikey": [
								{
									"key": "value",
									"value": "{{token}}",
									"type": "string"
								},
								{
									"key": "key",
									"value": "Authorization",
									"type": "string"
								},
								{
									"key": "in",
									"value": "header",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\"name\":\"{{$randomUserName}}\"}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{url}}/folder/{{folder_id}}/list",
							"host": [
								"{{url}}"
							],
							"path": [
								"folder",
